---
// Shared detail content for the desktop panel and the mobile accordion.
// Title and dates live in each layout, since they sit in different places.
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { maskIcon } from '../lib/icons';

interface Props {
  project: CollectionEntry<'projects'>;
  layout: 'desktop' | 'mobile'; // rendered once per layout, so popover ids need a suffix
}

const { project, layout } = Astro.props;
const popoverId = `${project.id}-image-${layout}`;
const { image, metric, tags, github, devpost, video, live } = project.data;
const { Content } = await render(project);

// Same options as the inline <Image>, so this resolves to the thumbnail the page already loaded
// Eager: lazy images inside hidden blocks don't start loading until shown, so a first click flashed blank
const thumb = image && (await getImage({ src: image.src, height: 440, loading: 'eager' }));
// The enlarged image's final size, set before it loads so the popover never collapses to the close button
// Reads size from getImage's plain clone: any property read on the imported image marks the original for emission to dist
const original = thumb && (thumb.options.src as ImageMetadata);
const enlarged = original && {
  width: Math.min(original.width, 1600),
  style: `width: min(90vw, ${Math.min(original.width, 1600)}px, calc(90dvh * ${original.width / original.height})); background-image: url(${thumb!.src});`,
};

const links = [
  { label: 'View on GitHub', href: github },
  { label: 'View on Devpost', href: devpost },
  { label: 'Watch video', href: video },
  { label: 'Visit live site', href: live },
].filter((link) => link.href);

const focusRing = 'rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-selected';
---

{image && (
  <div class="relative w-fit max-w-full shrink-0">
    {/* Natural aspect ratio, no box: the wrapper shrinks to the image so the button sits on its corner */}
    <img src={thumb!.src} {...thumb!.attributes} alt={image.alt} class="block h-auto max-h-[220px] w-auto max-w-full rounded-md" />
    <button
      type="button"
      popovertarget={popoverId}
      aria-label="Enlarge image"
      class={`absolute top-2 right-2 flex size-8 cursor-pointer items-center justify-center rounded-md bg-bg/85 ${focusRing}`}
    >
      <span class="icon-wash size-4 [--wash-size:32]" style={maskIcon('maximize-2')} aria-hidden="true"></span>
    </button>
    {/* Native popover: opens without JS, closes on Esc or a click outside */}
    <div id={popoverId} popover class="m-auto overflow-visible border-0 bg-transparent p-0 backdrop:bg-ink/70">
      {/* The thumbnail shows as a stretched background until the full image loads */}
      <Image src={image.src} alt={image.alt} width={enlarged!.width} loading="lazy" style={enlarged!.style} class="block h-auto rounded-md bg-contain bg-no-repeat" />
      <button
        type="button"
        popovertarget={popoverId}
        popovertargetaction="hide"
        aria-label="Close enlarged image"
        autofocus
        class={`absolute top-2 right-2 flex size-8 cursor-pointer items-center justify-center rounded-md bg-bg/85 ${focusRing}`}
      >
        <span class="icon-wash size-4 [--wash-size:32]" style={maskIcon('x')} aria-hidden="true"></span>
      </button>
    </div>
  </div>
)}

<div class="body flex shrink-0 flex-col gap-4">
  <Content />
</div>

{metric && <p class="shrink-0 text-base font-semibold">{metric}</p>}

<ul class="flex shrink-0 flex-wrap gap-2">
  {tags.map((tag) => <li class="rounded-full bg-bg px-2.5 py-0.5 text-[13px] text-sub">{tag}</li>)}
</ul>

{links.length > 0 && (
  <ul class="flex shrink-0 flex-wrap gap-x-6 gap-y-2">
    {links.map(({ label, href }) => (
      <li>
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${label} (opens in new tab)`}
          class={`wash inline-flex items-center gap-1 ${focusRing}`}
        >
          {/* Like Back: the link is the .wash, so one edge crosses the label and then the arrow */}
          {label}
          <span class="icon-wash size-4" style={maskIcon('arrow-up-right')} aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  /* Rendered Markdown body: description, bullets, key decision and teammates line */
  .body :global(p),
  .body :global(li) {
    font-size: 17px;
    line-height: 1.6;
    max-width: 68ch;
  }
  .body :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .body :global(strong) {
    font-weight: 600;
  }
  .body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85em;
  }
</style>
