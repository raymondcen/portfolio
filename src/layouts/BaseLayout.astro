---
import { Icon } from 'astro-icon/components';
import anSvg from '../assets/an.svg?raw';
import newsreader400 from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lockViewport?: boolean; // at 900px and up, lock the page to the viewport so only inner panels scroll
}

// Flip to true at launch
const SITE_LIVE = false;

const { title, description, noindex = false, lockViewport = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHome = Astro.url.pathname.replace(/\/+$/, '') === '';

// Strip the C2PA metadata and hardcoded fill so the glyph follows currentColor
const an = anSvg
  .replace(/<metadata>[\s\S]*?<\/metadata>/, '')
  .replace(/ xmlns:c2pa="[^"]*"/, '')
  .replace(/fill="[^"]*"/, 'fill="currentColor"')
  .replace('<svg', '<svg aria-hidden="true" class="block h-(--header-row) w-auto"');

const focusRing = 'rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-selected';

const socials = [
  { label: 'LinkedIn', icon: 'lucide:linkedin', href: 'https://www.linkedin.com/in/rcen/' },
  { label: 'Email', icon: 'lucide:mail', href: 'mailto:[email]' },
  { label: 'GitHub', icon: 'lucide:github', href: 'https://github.com/raymondcen' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !SITE_LIVE) && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raymond Cen" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={newsreader400} as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={['flex min-h-dvh flex-col bg-bg font-serif text-ink', lockViewport && 'min-[900px]:h-dvh min-[900px]:overflow-hidden']}>
    <header class="sticky top-0 z-10 grid shrink-0 grid-cols-[1fr_auto_1fr] grid-rows-[var(--header-row)] items-center bg-bg px-6 py-(--header-pad) sm:px-8">
      {isHome ? (
        <span title='"blessed peace"' class="justify-self-start select-none text-selected" set:html={an} />
      ) : (
        <a href="/" class={`wash group flex items-center gap-1 justify-self-start text-2xl leading-none ${focusRing}`}>
          {/* Negative margins trim the empty side padding in the chevron's 24-unit viewBox */}
          <Icon name="lucide:chevron-left" class="-mx-2 size-(--header-back) text-ink group-hover:text-selected group-focus-visible:text-selected" aria-hidden="true" />
          Back
        </a>
      )}
      <p class="text-3xl font-medium">Raymond Cen</p>
    </header>

    <main class="min-h-0 flex-1">
      <slot />
    </main>

    <footer class="sticky bottom-0 shrink-0 bg-bg py-4">
      <slot name="footer" />
      <ul class="flex justify-center gap-8">
        {socials.map(({ label, icon, href }) => {
          const external = href.startsWith('http');
          return (
            <li>
              <a
                href={href}
                aria-label={external ? `${label} (opens in new tab)` : label}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class={`block ${focusRing}`}
              >
                <Icon name={icon} class="size-6" aria-hidden="true" />
              </a>
            </li>
          );
        })}
      </ul>
    </footer>
  </body>
</html>
