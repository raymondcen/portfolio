---
import lucide from '@iconify-json/lucide/icons.json';
import anSvg from '../assets/an.svg?raw';
import newsreader400 from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lockViewport?: boolean; // at 900px and up, lock the page to the viewport so only inner panels scroll
}

// Flip to true at launch
const SITE_LIVE = false;

const { title, description, noindex = false, lockViewport = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHome = Astro.url.pathname.replace(/\/+$/, '') === '';

// Strip the C2PA metadata and hardcoded fill so the glyph follows currentColor
const an = anSvg
  .replace(/<metadata>[\s\S]*?<\/metadata>/, '')
  .replace(/ xmlns:c2pa="[^"]*"/, '')
  .replace(/fill="[^"]*"/, 'fill="currentColor"')
  // width/height keep it header-sized in any frame painted before the stylesheet applies; the class overrides them
  .replace('<svg', '<svg aria-hidden="true" width="87" height="42" class="block h-(--header-mark) w-auto"');

// Lucide icon as the mask of an .icon-wash: SVG strokes can't use background-clip, so the gradient shows through the icon
type LucideName = keyof typeof lucide.icons;
const maskIcon = (name: LucideName) =>
  `--icon: url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">${lucide.icons[name].body}</svg>`)}")`;

const focusRing = 'rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-selected';

const socials = [
  { label: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/in/rcen/' },
  // Spam protection: the address is never in the HTML. The footer script joins the parts.
  { label: 'Email', icon: 'mail', email: { user: 'contact', domain: 'rcen.dev' } },
  { label: 'GitHub', icon: 'github', href: 'https://github.com/raymondcen' },
] satisfies { label: string; icon: LucideName; href?: string; email?: { user: string; domain: string } }[];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !SITE_LIVE) && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raymond Cen" />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Raymond Cen, [tagline]" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={newsreader400} as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={['flex min-h-dvh flex-col bg-bg font-serif text-ink', lockViewport && 'min-[900px]:h-dvh min-[900px]:overflow-hidden']}>
    <header class="sticky top-0 z-10 grid shrink-0 grid-cols-[1fr_auto_1fr] grid-rows-[var(--header-row)] items-center bg-bg px-6 py-(--header-pad) sm:px-8">
      {isHome ? (
        <span title='"blessed peace"' class="justify-self-start select-none pr-4 text-selected sm:pr-0" set:html={an} />
      ) : (
        <a href="/" class={`wash flex items-center gap-1 justify-self-start pr-4 text-lg leading-none sm:pr-0 sm:text-2xl ${focusRing}`}>
          {/* Negative margins trim the empty side padding in the chevron's 24-unit viewBox */}
          <span class="icon-wash -mx-2 size-(--header-back)" style={maskIcon('chevron-left')} aria-hidden="true"></span>
          Back
        </a>
      )}
      <p class="text-3xl font-medium">Raymond Cen</p>
    </header>

    <main class="min-h-0 flex-1">
      <slot />
    </main>

    <footer class="sticky bottom-0 shrink-0 bg-bg py-(--footer-pad)">
      <slot name="footer" />
      <ul class="flex justify-center gap-8">
        {socials.map(({ label, icon, href, email }) => {
          if (email) return (
            <li hidden data-email-user={email.user} data-email-domain={email.domain}>
              <a aria-label={label} class={`block ${focusRing}`}>
                <span class="icon-wash size-6" style={maskIcon(icon)} aria-hidden="true"></span>
              </a>
            </li>
          );
          const external = href.startsWith('http');
          return (
            <li>
              <a
                href={href}
                aria-label={external ? `${label} (opens in new tab)` : label}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class={`block ${focusRing}`}
              >
                <span class="icon-wash size-6" style={maskIcon(icon)} aria-hidden="true"></span>
              </a>
            </li>
          );
        })}
      </ul>
    </footer>

    <script is:inline>
      // Constant wash speed: give each .wash its width + height so its duration scales with the distance swept.
      // Observing keeps it right through resizes, wrapping, the late web font and hidden blocks being shown.
      {
        const washObserver = new ResizeObserver((entries) => {
          for (const { target, borderBoxSize: [box] } of entries) {
            target.style.setProperty('--wash-size', Math.round(box.inlineSize + box.blockSize));
            // An icon inside the link (the Back chevron) paints the link's gradient at its own offset, so one edge crosses both
            const icon = target.querySelector('.icon-wash');
            if (icon) {
              const link = target.getBoundingClientRect();
              const { left, top } = icon.getBoundingClientRect();
              target.style.setProperty('--wash-w', `${link.width}px`);
              target.style.setProperty('--wash-h', `${link.height}px`);
              target.style.setProperty('--icon-x', `${left - link.left}px`);
              target.style.setProperty('--icon-y', `${top - link.top}px`);
            }
          }
        });
        for (const el of document.querySelectorAll('.wash')) washObserver.observe(el);
      }
      // Join the email parts so the address never appears in the built HTML. Without JS the item stays hidden.
      for (const li of document.querySelectorAll('[data-email-user]')) {
        li.querySelector('a').href = `mailto:${li.dataset.emailUser}@${li.dataset.emailDomain}`;
        li.hidden = false;
      }
    </script>
  </body>
</html>
