---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import { dates } from '../lib/dates';
import { maskIcon } from '../lib/icons';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-selected';
---

<BaseLayout title="Projects | Raymond Cen" description="[Projects meta description]" lockViewport>
  <noscript>
    <style>
      /* Without JS: drop the viewport lock so the stacked detail blocks scroll with the page */
      @media (min-width: 900px) {
        body { height: auto !important; overflow: visible !important; }
      }
    </style>
  </noscript>

  <h1 class="sr-only">Projects</h1>

  {/* Desktop: split view */}
  <div class="mx-auto hidden h-full max-w-[1120px] gap-6 px-8 py-2 min-[900px]:flex">
    <ul data-project-list class="panel relative flex-[0_1_360px] p-2">
      <li data-highlight aria-hidden="true" class="pointer-events-none absolute inset-x-2 top-0 rounded-md bg-panel-2"></li>
      {projects.map((project, i) => (
        <li>
          <button
            type="button"
            data-project-button
            data-slug={project.id}
            aria-current={i === 0 ? 'true' : undefined}
            class={`group relative z-1 flex min-h-11 w-full cursor-pointer flex-col rounded-md px-4 py-3.5 text-left aria-[current=true]:bg-panel-2 ${focusRing}`}
          >
            <span class="wash self-start text-lg font-semibold [overflow-wrap:anywhere]">{project.data.title}</span>
            <span class="text-[13px] text-sub italic">{dates(project.data)}</span>
            <span class="text-sm leading-[1.4] text-sub">{project.data.summary}</span>
          </button>
        </li>
      ))}
    </ul>

    <section id="project-detail" tabindex="0" aria-label="Project details" class={`panel flex-[1_1_560px] min-w-0 ${focusRing}`}>
      {projects.map((project) => (
        <article data-project-detail data-slug={project.id} class="flex flex-col gap-4 px-8 py-7">
          <div class="shrink-0">
            <h2 class="wash title-sweep w-fit text-[32px] leading-tight font-semibold [overflow-wrap:anywhere]">{project.data.title}</h2>
            <p class="text-[15px] text-sub italic">{dates(project.data)}</p>
          </div>
          <ProjectDetail project={project} layout="desktop" />
        </article>
      ))}
    </section>
  </div>

  {/* Mobile: native accordion */}
  <div class="px-4 pb-4 min-[900px]:hidden">
    <div class="rounded-[10px] bg-panel px-4">
      {projects.map((project, i) => (
        <details name="projects" open={i === 0} class="border-b border-divider last:border-b-0">
          <summary class={`group flex cursor-pointer list-none items-start gap-3 rounded-md py-4 ${focusRing}`}>
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="wash self-start text-lg font-semibold [overflow-wrap:anywhere]">{project.data.title}</span>
              <span class="text-[13px] text-sub italic">{dates(project.data)}</span>
              <span class="text-sm leading-[1.4] text-sub">{project.data.summary}</span>
            </span>
            <span class="icon-wash mt-0.5 size-6 shrink-0" style={maskIcon('chevron-down')} aria-hidden="true"></span>
          </summary>
          <div class="flex flex-col gap-4 pb-6">
            <ProjectDetail project={project} layout="mobile" />
          </div>
        </details>
      ))}
    </div>
  </div>

  <script is:inline>
    const buttons = document.querySelectorAll('[data-project-button]');
    const blocks = document.querySelectorAll('[data-project-detail]');
    const panel = document.getElementById('project-detail');
    const list = document.querySelector('[data-project-list]');
    const highlight = list.querySelector('[data-highlight]');

    // Match the selected row: rows differ in height because summaries wrap differently
    function place() {
      const b = list.querySelector('[aria-current="true"]');
      highlight.style.transform = `translateY(${b.offsetTop}px)`;
      highlight.style.height = `${b.offsetHeight}px`;
    }

    function select(slug) {
      for (const b of buttons) b.setAttribute('aria-current', b.dataset.slug === slug);
      for (const d of blocks) d.hidden = d.dataset.slug !== slug;
      panel.scrollTop = 0;
      place();
    }

    select(buttons[0].dataset.slug);

    // Hand the selected background from the buttons to the highlight, then animate only from the next frame on
    list.dataset.ready = '';
    highlight.offsetHeight; // flush so the initial placement never transitions
    requestAnimationFrame(() => (list.dataset.animate = ''));

    // Resize, the 900px breakpoint and the late Newsreader font all change row geometry: realign without animating.
    // Rows are observed too, since the list's own box doesn't change when only row heights do.
    const ro = new ResizeObserver(() => {
      highlight.style.transition = 'none';
      place();
      highlight.offsetHeight;
      highlight.style.transition = '';
    });
    for (const el of [list, ...buttons]) ro.observe(el);

    for (const b of buttons) {
      b.addEventListener('click', () => select(b.dataset.slug));
    }
  </script>
</BaseLayout>

<style>
  .panel {
    background: var(--color-panel);
    border-radius: 10px;
    overflow-x: hidden;
    overflow-y: auto;
    overflow-wrap: break-word;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: #B9B8B3 transparent;
  }

  /* Sliding selected highlight. Hidden until the script places it; buttons keep their own background without JS */
  [data-highlight] {
    display: none;
  }
  [data-ready] [data-highlight] {
    display: block;
  }
  [data-ready] [aria-current='true'] {
    background: none;
  }
  [data-animate] [data-highlight] {
    transition: transform 400ms ease-out, height 400ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-animate] [data-highlight] { transition: none; }
  }

  /* Detail title sweeps to green each time its block is shown: animations restart when an element leaves display: none */
  .title-sweep {
    animation: sweep var(--wash-duration) linear both;
  }
  @keyframes sweep {
    from { background-position: 100% 0; }
    to { background-position: 0 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .title-sweep { animation: none; background-position: 0 100%; }
  }

  /* Selected row title holds the wash's green end, so deselecting runs the transition back:
     ink sweeps in from the top right to the bottom left */
  [aria-current='true'] .wash {
    background-position: 0 100%;
  }

  /* .wash paints text with a clipped gradient, so the open title needs the gradient removed to show green */
  details[open] > summary .wash {
    background-image: none; /* not the shorthand: it would reset background-position and replay the sweep on deselect */
    color: var(--color-selected);
  }
  /* The chevron (.icon-wash, swept from the summary by global.css) is its masked background, so fill it solid
     and flip it */
  details[open] > summary > .icon-wash {
    background-image: none;
    background-color: var(--color-selected);
    rotate: 180deg;
  }

  /* Hovering anywhere on a row or summary sweeps its title */
  @media (hover: hover) {
    button:hover .wash,
    summary:hover .wash {
      background-position: 0 100%;
    }
  }
  button:focus-visible .wash,
  summary:focus-visible .wash {
    background-position: 0 100%;
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>
