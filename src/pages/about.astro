---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { tallChevron } from '../lib/icons';

const about = (await getEntry('about', 'index'))!;
const { Content } = await render(about);
const { photos, currently } = about.data;
const count = photos.length;
// One photo is a plain image: no dots, arrows, carousel semantics or script
const carousel = count > 1;

const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-selected';
// Strip cells in display order. The Listening cell carries data-np-* hooks for the live now-playing script
const cells = currently && [
  { label: 'Listening to', ...currently.listening },
  { label: 'Watching', ...currently.watching },
  { label: 'Reading', ...currently.reading },
  { label: 'Last hike', ...currently.hike },
];
const arrow = `arrow absolute top-1/2 flex h-22 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-md bg-bg/60 ${focusRing}`;
---

<BaseLayout title="About | Raymond Cen" description="[About meta description]">
  <h1 class="sr-only">About</h1>

  <div class="mx-auto flex max-w-[1120px] flex-col gap-4 px-4 pb-4 min-[900px]:gap-6 min-[900px]:px-8 min-[900px]:py-2">
  <div class="flex flex-col gap-4 min-[900px]:flex-row min-[900px]:gap-6">
    <div data-carousel class="relative min-w-0 min-[900px]:flex-[0_1_432px]">
      {count === 0 ? (
        <div class="flex aspect-[4/5] items-center justify-center rounded-[10px] bg-panel-2 text-sub">[Photos to come]</div>
      ) : (
        <div
          data-track
          class={`track flex aspect-[4/5] snap-x bg-panel-2 snap-mandatory overflow-x-auto rounded-[10px] ${focusRing}`}
          {...carousel && { role: 'region', tabindex: '0', 'aria-roledescription': 'carousel', 'aria-label': 'Photos' }}
        >
          {photos.map((photo, i) => (
            <div
              class="w-full shrink-0 snap-start"
              {...carousel && { role: 'group', 'aria-roledescription': 'slide', 'aria-label': `${i + 1} of ${count}` }}
            >
              <Image
                src={photo.src}
                alt={photo.alt ?? `Photo ${i + 1} of ${count}`}
                widths={[432, 864, 1296, 1728]}
                sizes="(min-width: 900px) 432px, calc(100vw - 32px)"
                loading={i === 0 ? 'eager' : 'lazy'}
                {...i === 0 && { decoding: 'sync', fetchpriority: 'high' }}
                class="size-full object-cover text-transparent"
              />
            </div>
          ))}
        </div>
      )}

      {carousel && (
        <>
          {/* Hidden until the script runs: without JS the photos still swipe and scroll natively */}
          <div data-dots hidden class="absolute bottom-2 left-1/2 flex -translate-x-1/2">
            {photos.map((_, i) => (
              <button type="button" data-dot aria-label={`Go to photo ${i + 1}`} class="dot flex cursor-pointer items-center justify-center rounded-sm focus-visible:outline-2 focus-visible:outline-selected">
                <span class="block rounded-full"></span>
              </button>
            ))}
          </div>
          <button type="button" data-arrow hidden aria-label="Previous photo" class={`${arrow} left-2`}>
            <span class="icon-wash h-10 w-[22px] [--wash-size:62]" style={tallChevron.left} aria-hidden="true"></span>
          </button>
          <button type="button" data-arrow hidden aria-label="Next photo" class={`${arrow} right-2`}>
            <span class="icon-wash h-10 w-[22px] [--wash-size:62]" style={tallChevron.right} aria-hidden="true"></span>
          </button>
        </>
      )}
    </div>

    <div class="bio flex flex-col gap-4 rounded-[10px] bg-panel px-4 pt-4 pb-5 leading-[1.6] min-[900px]:flex-[1_1_560px] min-[900px]:px-8 min-[900px]:py-7 min-[900px]:text-lg min-[900px]:leading-[1.65]">
      <Content />
    </div>
  </div>

  {cells && (
    <section aria-labelledby="currently" class="rounded-[10px] bg-panel min-[900px]:py-[22px]">
      <h2 id="currently" class="sr-only">Currently</h2>
      {/* 2 x 2 on mobile, 4 columns on desktop, with divider lines between cells only */}
      <dl class="grid grid-cols-2 min-[900px]:grid-cols-4">
        {cells.map((cell, i) => (
          <div
            data-np-cell={i === 0 ? '' : undefined}
            class:list={[
              'flex min-w-0 flex-col gap-1 border-divider p-4 min-[900px]:px-7 min-[900px]:py-0',
              i % 2 === 0 && 'border-r',
              i < 2 && 'border-b min-[900px]:border-b-0',
              i < 3 ? 'min-[900px]:border-r' : 'min-[900px]:border-r-0',
            ]}
          >
            <dt class="text-xs tracking-[0.08em] text-sub uppercase min-[900px]:text-[13px]">
              {/* The live script swaps the Listening label's text and shows the dot */}
              {i === 0 && <span data-np-dot hidden class="mr-1.5 inline-block size-[7px] rounded-full bg-selected align-middle"></span>}<span data-np-label={i === 0 ? '' : undefined}>{cell.label}</span>
            </dt>
            <dd class="min-w-0">
              {/* No url: an <a> without href is not a link or focusable, and gives the live script an element to fill */}
              <a
                href={cell.url}
                title={cell.title}
                {...cell.url && { target: '_blank', rel: 'noopener noreferrer', 'aria-label': `${cell.title} (opens in new tab)` }}
                class:list={['inline-block max-w-full truncate align-top text-lg min-[900px]:text-xl', focusRing, cell.url ? 'wash' : 'text-ink']}
                data-np-link={i === 0 ? '' : undefined}
              ><span data-np-title={i === 0 ? '' : undefined} class={i === 0 ? 'np-line block truncate' : undefined}>{cell.title}</span></a>
            </dd>
            <dd class="truncate text-sm text-sub min-[900px]:text-[15px]" title={cell.detail} data-np-detail={i === 0 ? '' : undefined}>
              {i === 0 ? <span class="np-line block truncate">{cell.detail}</span> : cell.detail}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )}
  </div>

  {carousel && (
    <script is:inline>
      {
        const root = document.querySelector('[data-carousel]');
        const track = root.querySelector('[data-track]');
        const dots = [...root.querySelectorAll('[data-dot]')];
        const [prev, next] = root.querySelectorAll('[data-arrow]');
        const reduce = matchMedia('(prefers-reduced-motion: reduce)');
        const last = dots.length - 1;
        let active = 0;

        function show(i) {
          active = i;
          // At most 5 dots, centered on the active one and pinned at both ends.
          // Dots outside the window collapse to zero width instead of hiding, so the row slides
          const start = Math.max(0, Math.min(i - 2, dots.length - 5));
          // Three full-size dots centered on the active one. On the first or last photo they shift inward,
          // so the two dots after the first (or before the last) match the active one
          const mid = Math.max(1, Math.min(i, last - 1));
          dots.forEach((dot, j) => {
            const out = j < start || j >= start + 5;
            dot.inert = out;
            dot.style.setProperty('--d', out ? '0px' : Math.abs(j - mid) <= 1 ? '8px' : '5px');
            if (j === i) dot.setAttribute('aria-current', 'true');
            else dot.removeAttribute('aria-current');
          });
          // No wrap-around: hide Previous on the first photo and Next on the last
          for (const [button, end] of [[prev, i === 0], [next, i === last]]) {
            if (end && document.activeElement === button) track.focus();
            button.hidden = end;
          }
        }

        const go = (i) =>
          track.scrollTo({ left: Math.max(0, Math.min(i, last)) * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });

        track.addEventListener('scroll', () => {
          const i = Math.round(track.scrollLeft / track.clientWidth);
          if (i !== active) show(i);
        }, { passive: true });
        track.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          e.preventDefault();
          go(active + (e.key === 'ArrowLeft' ? -1 : 1));
        });
        prev.addEventListener('click', () => go(active - 1));
        next.addEventListener('click', () => go(active + 1));
        dots.forEach((dot, j) => dot.addEventListener('click', () => go(j)));

        show(0);
        root.querySelector('[data-dots]').hidden = false;
      }
    </script>
  )}
  {cells && (
    <script is:inline>
      // Live Listening cell from /api/now-playing. The server-rendered fallback stays until a fetch returns playing or recent.
      // No aria-live: a per-minute announcement would be noise
      {
        const $ = (name) => document.querySelector(`[data-np-${name}]`);
        const [dot, label, link, title, detail] = ['dot', 'label', 'link', 'title', 'detail'].map($);
        const lines = document.querySelectorAll('[data-np-cell] .np-line');
        let np;

        // Hover scroll: each line that overflows gets its overflow as --np-shift and a 30px/s duration as --np-dur.
        // A negative text-indent doesn't change scrollWidth, so this measures correctly even mid-scroll
        function fit() {
          for (const el of lines) {
            const over = el.scrollWidth - el.clientWidth;
            el.style.setProperty('--np-shift', over > 1 ? `${-over}px` : '0px');
            el.style.setProperty('--np-dur', `${Math.max(over, 0) / 30}s`);
          }
        }
        addEventListener('resize', fit);
        let timer;

        // One place for the track URL format
        const trackLink = ({ trackId, trackUrl, playlistId }) =>
          playlistId ? `https://open.spotify.com/playlist/${playlistId}?highlight=spotify:track:${trackId}` : trackUrl;

        function ago(iso) {
          const m = Math.floor((Date.now() - Date.parse(iso)) / 60000);
          if (m < 1) return 'just now';
          if (m < 60) return `${m}m ago`;
          if (m < 1440) return `${Math.floor(m / 60)}h ago`;
          return `${Math.floor(m / 1440)}d ago`;
        }

        function render() {
          const playing = np.state === 'playing';
          dot.hidden = !playing;
          if (playing) label.replaceChildren('Listening now');
          else {
            const time = document.createElement('time');
            time.dateTime = np.playedAt;
            time.textContent = ago(np.playedAt);
            // The label is uppercase; the time keeps its lowercase "2m ago"
            time.className = 'normal-case';
            label.replaceChildren('Last played · ', time);
          }

          link.href = trackLink(np);
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.title = title.textContent = np.track;
          link.setAttribute('aria-label', `${np.track} (opens in new tab)`);
          // Adding .wash adds its transition while background-position jumps from the default to 100% 0,
          // which would sweep on every load. Apply it with no transition so only hover and focus sweep
          const swapped = link.classList.replace('text-ink', 'wash');
          if (swapped) link.style.transition = 'none';
          // BaseLayout sizes washes present at load; this one changes with every track
          link.style.setProperty('--wash-size', link.offsetWidth + link.offsetHeight);
          if (swapped) link.style.transition = '';

          detail.title = detail.firstElementChild.textContent = np.artists;
          fit();
        }

        // Keeps the last good data on a failed fetch, and recomputes the relative time either way.
        // A failure while playing turns it into "Last played" now, so "Listening now" never sticks.
        async function tick() {
          let data;
          try {
            data = await (await fetch('/api/now-playing')).json();
          } catch {}
          if (data?.state === 'playing' || data?.state === 'recent') np = data;
          else if (np?.state === 'playing') np = { ...np, state: 'recent', playedAt: new Date().toISOString() };
          if (np) render();
        }

        // Poll every 30s only while visible
        function schedule() {
          clearInterval(timer);
          if (document.visibilityState === 'visible') timer = setInterval(tick, 30000);
        }
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') tick();
          schedule();
        });
        tick();
        schedule();
      }
    </script>
  )}
</BaseLayout>

<style>
  .track {
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }

  /* Hit area 14 x 24 centered on the dot. Margins keep a 6px gap between dots: (dot + gap - 14) / 2 per side.
     Out-of-window dots take no space (dot 0, gap 0), so the centered row slides as they collapse and grow.
     Two steps: the green moves first (120ms), then the row slides and resizes (250ms) */
  .dot {
    --d: 5px;
    --g: 6px;
    width: 14px;
    height: 24px;
    margin-inline: calc((var(--d) + var(--g)) / 2 - 7px);
    transition: margin 250ms ease-in-out 120ms;
  }
  .dot[inert] {
    --g: 0px;
  }
  .dot > span {
    width: var(--d);
    height: var(--d);
    background: #FFFFFF;
    transition: background-color 120ms, width 250ms ease-in-out 120ms, height 250ms ease-in-out 120ms;
  }
  .dot[aria-current='true'] > span {
    background: var(--color-selected);
  }

  /* Arrows: desktop with hover only, shown while the pointer is over the photo or the carousel has keyboard focus.
     :focus-visible, not :focus-within: a clicked arrow or dot keeps focus, which would hold the arrows after the pointer leaves */
  .arrow {
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease-out;
  }
  [data-carousel]:hover .arrow,
  [data-carousel]:has(:focus-visible) .arrow {
    opacity: 1;
    pointer-events: auto;
  }
  @media not ((hover: hover) and (min-width: 900px)) {
    .arrow { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot, .dot > span, .arrow { transition: none; }
  }

  /* Listening cell: hovering the cell slides each overflowing line left at 30px/s until its end shows, then it stops.
     The script sets --np-shift and --np-dur. text-indent, not transform: a transform can't move inline text,
     and moving a whole child box would lose the ellipsis at rest. Leaving eases back to the start */
  .np-line {
    transition: text-indent 400ms ease-out;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-np-cell]:hover .np-line {
      text-indent: var(--np-shift, 0px);
      transition: text-indent var(--np-dur, 0s) linear 100ms;
    }
  }

  /* Desktop: the bio matches the photo's top and height. Size containment drops its content height,
     so the row's height comes from the photo and the bio stretches to it, scrolling if the text ever outgrows it */
  @media (min-width: 900px) {
    .bio {
      contain: size;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: #B9B8B3 transparent;
    }
  }
</style>
