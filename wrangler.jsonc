{
  "name": "portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [
    { "pattern": "rcen.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
